[gd_resource type="Theme" format=3 uid="uid://d2wmg5g7tg0uc"]

; Godot の既定フォントは日本語のグリフを持たず、UI が全部豆腐（□）になる。
; 丸ゴシックなのでポップな見た目とも合う（ライセンスは ui/fonts/OFL.txt）
[ext_resource type="FontFile" uid="uid://blj3ujq0wybpb" path="res://ui/fonts/MPLUSRounded1c-Bold.ttf" id="1_font"]

; 配色は tools/blender/build_ui_art.py（ロゴとアイコン）と揃えてある:
;   板 = 黄 #ffd23f、ふち・影 = 濃い紫 #3b1d6e、パネル = 紫の半透明＋白いふち。
; ボタンは「濃い紫のふち＋下へずらした同色の影」で分厚い板に見せる。
; pressed は影を短くして文字を下げ、板ごと沈んだように見せる
