layout_mode = 2
theme_override_styles/panel = SubResource("lobby_panel")

[node name="Col" type="VBoxContainer" parent="Lobby/Box"]
layout_mode = 2
theme_override_constants/separation = 16

; 4つの席を絵で並べる（人＝キャラ、足りない鬼を埋める CPU＝ロボ、空席＝薄いキャラ）。
; 中身は lobby_panel.gd が人数に合わせて組み直す
[node name="SeatsRow" type="HBoxContainer" parent="Lobby/Box/Col"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

; 原因を伝える注記（EOS 未接続で部屋が他の PC から見えない等）だけを文字で出す
