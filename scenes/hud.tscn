; 待機中だけ出るロビー。HUD で唯一クリックできる要素なので、
; hud.gd の _ignore_mouse() はこのノード以下を対象外にしている。
; ラウンド中は visible=false なので、マウスキャプチャ中の視点操作を邪魔しない
[node name="Lobby" type="CenterContainer" parent="."]
visible = false
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_lobby_panel")

[node name="Box" type="PanelContainer" parent="Lobby"]
