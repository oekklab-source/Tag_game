; モデルが実寸（全高1.74m）なので拡大は不要
[node name="Humanoid" parent="." instance=ExtResource("2_humanoid")]

; 経路点の「到達した」判定は 3D 距離で行われるが、焼かれたナビメッシュは床より
; 約1m 高い所にある。0.6 のままだと水平にどれだけ寄っても到達扱いにならず、
; 経路点が進まないまま同じ場所で前後に振動する（ダッシュ時に顕著）。
; 逃走者は鬼より速い局面が多いので、ここは広めに取る
[node name="NavigationAgent3D" type="NavigationAgent3D" parent="."]
path_desired_distance = 1.5
target_desired_distance = 1.5

[node name="MultiplayerSynchronizer" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_interval = 0.05
replication_config = SubResource("repl_config")
