{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2021"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // テストは node --test が型を外して直接走らせる。@types/node を足さないため型検査からは外す(KAN-103)
  "exclude": ["src/**/*.test.ts"]
}
